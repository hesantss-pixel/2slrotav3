{
  "rules": {
    ".read": false,
    ".write": false,
    "pedidos": {
      ".read": "auth != null && (root.child('separacao').child(auth.uid).val() === true || (root.child('acesso').child(auth.uid).val() === true && root.child('membros').child(auth.uid).val() === 'principal'))",
      ".write": "auth != null && (root.child('separacao').child(auth.uid).val() === true || (root.child('acesso').child(auth.uid).val() === true && root.child('membros').child(auth.uid).val() === 'principal'))"
    },
    "acesso": {
      ".read": "auth != null && auth.uid === 'PGblgW7V26SJ6W8UYPFj3dqlDGm2'",
      ".write": "auth != null && auth.uid === 'PGblgW7V26SJ6W8UYPFj3dqlDGm2'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === true || newData.val() === 'demo'"
      }
    },
    "demos": {
      ".read": "auth != null && auth.uid === 'PGblgW7V26SJ6W8UYPFj3dqlDGm2'",
      ".write": "auth != null && auth.uid === 'PGblgW7V26SJ6W8UYPFj3dqlDGm2'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "usuarios": {
      ".read": "auth != null && auth.uid === 'PGblgW7V26SJ6W8UYPFj3dqlDGm2'",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['email', 'visto'])",
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "visto": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "solicitacoes": {
      ".read": "auth != null && auth.uid === 'PGblgW7V26SJ6W8UYPFj3dqlDGm2'",
      ".write": "auth != null && auth.uid === 'PGblgW7V26SJ6W8UYPFj3dqlDGm2'",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && !root.child('acesso').child($uid).exists()",
        ".validate": "newData.hasChildren(['email', 'em'])",
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "em": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "config": {
      ".read": "auth != null && auth.uid === 'PGblgW7V26SJ6W8UYPFj3dqlDGm2'",
      ".write": false
    },
    "pedidos_rota": {
      ".read": "auth != null && auth.uid === 'PGblgW7V26SJ6W8UYPFj3dqlDGm2'",
      ".write": "auth != null && auth.uid === 'PGblgW7V26SJ6W8UYPFj3dqlDGm2'"
    },
    "rotas": {
      ".read": "auth != null && auth.uid === 'PGblgW7V26SJ6W8UYPFj3dqlDGm2'",
      ".write": "auth != null && auth.uid === 'PGblgW7V26SJ6W8UYPFj3dqlDGm2'"
    },
    "rotas_confirmadas": {
      ".read": "auth != null && auth.uid === 'PGblgW7V26SJ6W8UYPFj3dqlDGm2'",
      ".write": "auth != null && auth.uid === 'PGblgW7V26SJ6W8UYPFj3dqlDGm2'"
    },
    "motoristas": {
      ".read": "auth != null && auth.uid === 'PGblgW7V26SJ6W8UYPFj3dqlDGm2'",
      ".write": "auth != null && auth.uid === 'PGblgW7V26SJ6W8UYPFj3dqlDGm2'"
    },
    "produtos": {
      ".read": "auth != null && auth.uid === 'PGblgW7V26SJ6W8UYPFj3dqlDGm2'",
      ".write": "auth != null && auth.uid === 'PGblgW7V26SJ6W8UYPFj3dqlDGm2'",
      "$k": {
        ".validate": "newData.hasChildren(['d','cm']) && newData.child('d').isString() && newData.child('d').val().length <= 120"
      }
    },
    "geo_cache": {
      ".read": "auth != null && root.child('acesso').child(auth.uid).val() === true",
      "$cep": {
        ".write": "auth != null && root.child('acesso').child(auth.uid).val() === true && newData.exists()",
        ".validate": "$cep.matches(/^[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]$/) && newData.hasChildren(['lat', 'lng']) && newData.child('lat').isNumber() && newData.child('lat').val() >= -34 && newData.child('lat').val() <= 6 && newData.child('lng').isNumber() && newData.child('lng').val() >= -75 && newData.child('lng').val() <= -28",
        "bairro": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "cidade": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "uf": { ".validate": "newData.isString() && newData.val().length <= 2" },
        "rua": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "prec": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "v": { ".validate": "newData.isNumber()" },
        "$outro": { ".validate": false }
      }
    },
    "sync_log": {
      ".read": "auth != null && auth.uid === 'PGblgW7V26SJ6W8UYPFj3dqlDGm2'",
      ".write": false
    },
    "entregador": {
      ".read": "auth != null && auth.uid === 'PGblgW7V26SJ6W8UYPFj3dqlDGm2'",
      ".write": "auth != null && auth.uid === 'PGblgW7V26SJ6W8UYPFj3dqlDGm2'",
      "$token": {
        ".read": "($token.length >= 20 && data.child('expira').val() > now) || (auth != null && root.child('acesso').child(auth.uid).val() === true && data.child('eid').val() === root.child('membros').child(auth.uid).val())",
        ".write": "auth != null && root.child('acesso').child(auth.uid).val() === true && root.child('membros').child(auth.uid).exists() && (!data.exists() || data.child('eid').val() === root.child('membros').child(auth.uid).val()) && newData.child('eid').val() === root.child('membros').child(auth.uid).val()",
        "baixas": {
          "$i": {
            ".write": "root.child('entregador').child($token).child('expira').val() > now && root.child('entregador').child($token).child('paradas').child($i).exists()",
            ".validate": "newData.hasChildren(['status', 'hora'])",
            "status": {
              ".validate": "newData.val() === 'feito' || newData.val() === 'nao_feito'"
            },
            "hora": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000"
            },
            "motivo": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "obs": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "recebedor": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "temFoto": {
              ".validate": "newData.isBoolean()"
            },
            "lat": {
              ".validate": "newData.isNumber()"
            },
            "lng": {
              ".validate": "newData.isNumber()"
            },
            "$outro": {
              ".validate": false
            }
          }
        },
        "fotos": {
          "$i": {
            ".write": "root.child('entregador').child($token).child('expira').val() > now && root.child('entregador').child($token).child('paradas').child($i).exists()",
            ".validate": "newData.isString() && newData.val().length < 400000 && newData.val().matches(/^data:image\\/jpeg;base64,[A-Za-z0-9+\\/]+=*$/)"
          }
        },
        "posicao": {
          ".write": "root.child('entregador').child($token).child('expira').val() > now",
          ".validate": "newData.hasChildren(['lat', 'lng', 'hora'])",
          "lat": {
            ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
          },
          "lng": {
            ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
          },
          "precisao": {
            ".validate": "newData.isNumber()"
          },
          "hora": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "$outro": {
            ".validate": false
          }
        },
        "hodometro": {
          "$qual": {
            ".write": "root.child('entregador').child($token).child('expira').val() > now && ($qual === 'ini' || $qual === 'fim')",
            ".validate": "newData.hasChildren(['km', 'hora'])",
            "km": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10000000"
            },
            "hora": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000"
            },
            "temFoto": {
              ".validate": "newData.isBoolean()"
            },
            "$outro": {
              ".validate": false
            }
          }
        },
        "fotos_hod": {
          "$qual": {
            ".write": "root.child('entregador').child($token).child('expira').val() > now && ($qual === 'ini' || $qual === 'fim')",
            ".validate": "newData.isString() && newData.val().length < 400000 && newData.val().matches(/^data:image\\/jpeg;base64,[A-Za-z0-9+\\/]+=*$/)"
          }
        },
        "trilha": {
          "$k": {
            ".write": "root.child('entregador').child($token).child('expira').val() > now && !data.exists()",
            ".validate": "newData.hasChildren(['lat', 'lng', 't'])",
            "lat": {
              ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
            },
            "lng": {
              ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now + 600000 && newData.val() > now - 172800000"
            },
            "acc": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "v": {
              ".validate": "newData.isNumber()"
            },
            "$outro": {
              ".validate": false
            }
          }
        },
        "gps": {
          "$i": {
            ".write": "root.child('entregador').child($token).child('expira').val() > now && root.child('entregador').child($token).child('paradas').child($i).exists()",
            ".validate": "newData.hasChildren(['lat', 'lng', 'precisao'])",
            "lat": {
              ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
            },
            "lng": {
              ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
            },
            "precisao": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "$outro": {
              ".validate": false
            }
          }
        }
      }
    },
    "membros": {
      ".read": "auth != null && auth.uid === 'PGblgW7V26SJ6W8UYPFj3dqlDGm2'",
      ".write": "auth != null && auth.uid === 'PGblgW7V26SJ6W8UYPFj3dqlDGm2'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString() && newData.val().length <= 60"
      }
    },
    "empresas": {
      ".read": "auth != null && auth.uid === 'PGblgW7V26SJ6W8UYPFj3dqlDGm2'",
      ".write": "auth != null && auth.uid === 'PGblgW7V26SJ6W8UYPFj3dqlDGm2'",
      "$eid": {
        ".read": "auth != null && ((root.child('acesso').child(auth.uid).val() === true && root.child('membros').child(auth.uid).val() === $eid) || ($eid === 'demo_' + auth.uid && root.child('acesso').child(auth.uid).val() === 'demo' && root.child('demos').child(auth.uid).child('expira').val() > now))",
        "pedidos_rota": {
          ".write": "auth != null && ((root.child('acesso').child(auth.uid).val() === true && root.child('membros').child(auth.uid).val() === $eid) || ($eid === 'demo_' + auth.uid && root.child('acesso').child(auth.uid).val() === 'demo' && root.child('demos').child(auth.uid).child('expira').val() > now))"
        },
        "rotas": {
          ".write": "auth != null && ((root.child('acesso').child(auth.uid).val() === true && root.child('membros').child(auth.uid).val() === $eid) || ($eid === 'demo_' + auth.uid && root.child('acesso').child(auth.uid).val() === 'demo' && root.child('demos').child(auth.uid).child('expira').val() > now))"
        },
        "rotas_confirmadas": {
          ".write": "auth != null && ((root.child('acesso').child(auth.uid).val() === true && root.child('membros').child(auth.uid).val() === $eid) || ($eid === 'demo_' + auth.uid && root.child('acesso').child(auth.uid).val() === 'demo' && root.child('demos').child(auth.uid).child('expira').val() > now))"
        },
        "motoristas": {
          ".write": "auth != null && ((root.child('acesso').child(auth.uid).val() === true && root.child('membros').child(auth.uid).val() === $eid) || ($eid === 'demo_' + auth.uid && root.child('acesso').child(auth.uid).val() === 'demo' && root.child('demos').child(auth.uid).child('expira').val() > now))",
          "$mid": {
            "comb": { ".validate": "newData.val() === 'diesel' || newData.val() === 'gasolina' || newData.val() === 'etanol'" },
            "cons": { ".validate": "newData.isNumber() && newData.val() >= 0.5 && newData.val() <= 50" },
            "vinculo": { ".validate": "newData.val() === 'agregado'" },
            "ag_saida": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
            "ag_km": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50" }
          }
        },
        "produtos": {
          ".write": "auth != null && ((root.child('acesso').child(auth.uid).val() === true && root.child('membros').child(auth.uid).val() === $eid) || ($eid === 'demo_' + auth.uid && root.child('acesso').child(auth.uid).val() === 'demo' && root.child('demos').child(auth.uid).child('expira').val() > now))",
          "$k": {
            ".validate": "newData.hasChildren(['d','cm']) && newData.child('d').isString() && newData.child('d').val().length <= 120"
          }
        },
        "config": {
          "locais": {
            ".write": "auth != null && ((root.child('acesso').child(auth.uid).val() === true && root.child('membros').child(auth.uid).val() === $eid) || ($eid === 'demo_' + auth.uid && root.child('acesso').child(auth.uid).val() === 'demo' && root.child('demos').child(auth.uid).child('expira').val() > now))"
          },
          "cubagem": {
            ".write": "auth != null && ((root.child('acesso').child(auth.uid).val() === true && root.child('membros').child(auth.uid).val() === $eid) || ($eid === 'demo_' + auth.uid && root.child('acesso').child(auth.uid).val() === 'demo' && root.child('demos').child(auth.uid).child('expira').val() > now))",
            ".validate": "newData.hasChildren(['fator']) && newData.child('fator').isNumber() && newData.child('fator').val() >= 50 && newData.child('fator').val() <= 1000"
          },
          "modelos_planilha": {
            ".write": "auth != null && ((root.child('acesso').child(auth.uid).val() === true && root.child('membros').child(auth.uid).val() === $eid) || ($eid === 'demo_' + auth.uid && root.child('acesso').child(auth.uid).val() === 'demo' && root.child('demos').child(auth.uid).child('expira').val() > now))",
            "$sig": { ".validate": "$sig.matches(/^c[0-9]{1,3}_[0-9a-z]{1,8}$/) && newData.isString() && newData.val().length <= 3000" }
          },
          "custos": {
            ".write": "auth != null && ((root.child('acesso').child(auth.uid).val() === true && root.child('membros').child(auth.uid).val() === $eid) || ($eid === 'demo_' + auth.uid && root.child('acesso').child(auth.uid).val() === 'demo' && root.child('demos').child(auth.uid).child('expira').val() > now))",
            ".validate": "newData.hasChildren(['diesel', 'gasolina', 'encargos', 'ajudSal', 'tipos'])",
            "v": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99" },
            "diesel": { ".validate": "newData.isNumber() && newData.val() >= 0.01 && newData.val() <= 50" },
            "gasolina": { ".validate": "newData.isNumber() && newData.val() >= 0.01 && newData.val() <= 50" },
            "etanol": { ".validate": "newData.isNumber() && newData.val() >= 0.01 && newData.val() <= 50" },
            "encargos": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 300" },
            "ajudSal": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
            "horasMes": { ".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 400" },
            "tipos": {
              "$t": {
                ".validate": "$t.matches(/^(fiorino|vuc|tres4|toco|bitruck|carreta)$/)",
                "cons": { ".validate": "newData.isNumber() && newData.val() >= 0.5 && newData.val() <= 50" },
                "comb": { ".validate": "newData.val() === 'diesel' || newData.val() === 'gasolina'" },
                "manut": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50" },
                "sal": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
                "ajud": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5" },
                "diaria": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
                "$outro": { ".validate": false }
              }
            },
            "$outro": { ".validate": false }
          },
          "ssw": {
            ".write": "auth != null && ((root.child('acesso').child(auth.uid).val() === true && root.child('membros').child(auth.uid).val() === $eid) || ($eid === 'demo_' + auth.uid && root.child('acesso').child(auth.uid).val() === 'demo' && root.child('demos').child(auth.uid).child('expira').val() > now))",
            "codigos": {
              "$k": { ".validate": "$k.matches(/^(entregue|coletado|ausente|endereco|recusado|fechado|avaria|tempo|outro)$/) && newData.isString() && newData.val().matches(/^[A-Za-z0-9]{1,6}$/)" }
            },
            "$outro": { ".validate": false }
          }
        }
      }
    }
  }
}
